  include("${PACKAGE_PREFIX_DIR}/thirdParty/thirdPartyConfigPath.cmake")
endif()

if(NOT TARGET ASRCAISim1::Core)
    include("${CMAKE_CURRENT_LIST_DIR}/ASRCAISim1Targets.cmake")
endif()
if(NOT TARGET ASRCAISim1::All)
    # ALIASの作成
    add_library(ASRCAISim1_All INTERFACE IMPORTED)
    target_link_libraries(ASRCAISim1_All INTERFACE ASRCAISim1::Core)
    add_library(ASRCAISim1::All ALIAS ASRCAISim1_All)
endif()

